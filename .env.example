# Copy this file to .env and fill in real values before deploying publicly.

# Secret used to sign login sessions (JWT). CHANGE THIS before going live.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Port the Node server listens on (most hosts set this automatically)
PORT=3000

# Only needed if the frontend and backend are deployed on DIFFERENT domains.
# If they're served together (the default in this project), leave it unset.
# VITE_API_URL=https://tu-backend.onrender.com

# Nota: Mapa Pet usa Leaflet + OpenStreetMap, así que NO necesita ninguna
# API key — funciona apenas instales las dependencias.
